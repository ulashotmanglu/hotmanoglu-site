{{- $items := slice -}}
{{- range where site.RegularPages "Section" "posts" -}}
  {{- $cat := "" -}}
  {{- with .Params.categories -}}{{- range first 1 . -}}{{- $cat = . -}}{{- end -}}{{- end -}}
  {{- $items = $items | append (dict
      "t" .Title
      "u" .RelPermalink
      "d" (.Params.description | default "" | plainify | truncate 160)
      "c" $cat
      "g" (delimit (.Params.tags | default slice) " ")
      "y" (.Date.Format "2006")
      "r" .ReadingTime
  ) -}}
{{- end -}}
{{- range partialCached "video/list.html" site "all" -}}
  {{- $items = $items | append (dict
      "t" .headline
      "u" .url
      "d" (partial "video/dek.html" (dict "v" . "max" 160) | htmlUnescape)
      "c" "Video"
      "g" (delimit (apply .series "index" "." "title") " ")
      "y" (.date.Format "2006")
  ) -}}
{{- end -}}
{{- $items | jsonify -}}
